rules_version = '2';

// 여행 일정 규칙
// - 읽기·쓰기: 아래 목록의 구글 계정으로 로그인한 사람만 (이메일 인증된 계정)
// - trips/japan-2026 문서 하나만 사용, 삭제는 막음
// 사람을 추가하려면 editors() 목록에 이메일을 넣고 Firebase 콘솔에 다시 게시하세요.
// ※ 공개용 예시입니다. firestore.rules 로 복사해서 실제 이메일을 넣고 Firebase 콘솔에 게시하세요.
service cloud.firestore {
  match /databases/{database}/documents {
    function editors() {
      return ['editor1@example.com', 'editor2@example.com'];
    }

    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in editors();
    }

    // 사이트가 "내가 편집자인지" 확인할 때만 씀. 편집자 본인만 읽을 수 있음 (문서는 없어도 됨)
    match /editors/{email} {
      allow read: if isEditor() && request.auth.token.email == email;
      allow write: if false;
    }

    match /trips/{tripId} {
      allow read: if tripId == 'japan-2026' && isEditor();

      allow create, update: if tripId == 'japan-2026'
        && isEditor()
        && request.resource.data.keys().hasOnly(['title', 'destination', 'startDate', 'endDate', 'days', 'tr'])
        && request.resource.data.days is list
        && request.resource.data.days.size() <= 31;

      allow delete: if false;
    }
  }
}
