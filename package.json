{
  "name": "travel-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Vue 2 + Nuxt 2 기반 날짜별 여행 계획 페이지",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider nuxt",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider nuxt build",
    "start": "nuxt start",
    "generate": "cross-env NODE_OPTIONS=--openssl-legacy-provider nuxt generate",
    "build:pages": "cross-env NODE_OPTIONS=--openssl-legacy-provider DEPLOY_BASE=/travel/ nuxt generate",
    "deploy": "npm run build:pages && node scripts/deploy-pages.js"
  },
  "dependencies": {
    "core-js": "^3.37.1",
    "firebase": "^10.14.1",
    "nuxt": "^2.17.3",
    "vue": "^2.7.16",
    "vue-server-renderer": "^2.7.16",
    "vue-template-compiler": "^2.7.16"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "webpack": "^4.47.0"
  }
}
